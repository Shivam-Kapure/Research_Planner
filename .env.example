# Copy to `.env` (repository root) for local development. Never commit `.env`.
# Placeholders only. Real secrets live in local .env files or hosting dashboards.

# ---- Local PostgreSQL (docker-compose.yml) ----
POSTGRES_USER=researchpilot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=researchpilot
POSTGRES_PORT=5432

# ---- Backend (FastAPI + Alembic; read from this root .env) ----
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
# Must match the POSTGRES_* values above. postgresql:// URLs are converted to asyncpg.
DATABASE_URL=postgresql+asyncpg://researchpilot:change-me-local-only@localhost:5432/researchpilot
# Fernet key(s), comma-separated, newest first. Generate one with:
#   cd backend && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored provider credentials unreadable. Never commit it.
CREDENTIAL_ENCRYPTION_KEYS=
SESSION_TTL_DAYS=7
# false only for local plain-http development; must be true in production.
SESSION_COOKIE_SECURE=false

# ---- LLM providers (backend) ----
# Users add their own Groq/Gemini keys in the app after logging in; keys are never set here.
# Candidate model IDs, comma-separated, in order of preference. List only models that the
# provider currently offers on its FREE tier (check the Groq and Gemini rate-limit/pricing
# docs before setting). A provider with a stored key but no models listed is not used.
GROQ_MODELS=
GEMINI_MODELS=
# Client-side pacing to stay within free-tier per-minute limits.
GROQ_REQUESTS_PER_MINUTE=20
GEMINI_REQUESTS_PER_MINUTE=8
LLM_REQUEST_TIMEOUT_S=60
# Optional: cap Gemini "thinking" tokens (they count against the output limit).
# GEMINI_THINKING_BUDGET=0

# ---- Academic sources (backend; all optional and free) ----
# OpenAlex "polite pool" contact email, and an optional free OpenAlex API key.
OPENALEX_EMAIL=
OPENALEX_API_KEY=
# Optional free Semantic Scholar key (request form, no payment). Without it the shared public
# pool is used, which is often rate-limited; searches then continue with OpenAlex only.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_REQUESTS_PER_MINUTE=30
LITERATURE_TIMEOUT_S=20

# ---- Backend tests (pytest) ----
# Disposable database; its name must end in _test. Tests truncate it.
TEST_DATABASE_URL=postgresql+asyncpg://researchpilot:change-me-local-only@localhost:5432/researchpilot_test

# ---- Frontend (Next.js) ----
# Put frontend variables in `frontend/.env.local` (Next.js reads env from its own folder).
# Server-side only: never prefix with NEXT_PUBLIC_.
# BACKEND_URL=http://localhost:8000
